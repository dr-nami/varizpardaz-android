{
  "_comment": "Cases for RegexDialect, run by the JVM tests (:core) and by the instrumented tests on a device, because the Android regex engine (ICU) differs from the JVM's. `match` false means no match; `groups` are checked when present; `rejected` means compile must fail.",
  "cases": [
    { "name": "plain literal", "pattern": "واریز", "text": "مبلغ واریز شد", "match": true },
    { "name": "named groups with amounts", "pattern": "واریز:\\s*(?<amount>[0-9,]+)\\s*ریال\\s*حساب:\\s*(?<account>[0-9]+)", "text": "واریز: 5,000 ریال حساب: 1234", "match": true, "groups": { "amount": "5,000", "account": "1234" } },
    { "name": "group name with underscore", "pattern": "(?<origin_last4>[0-9]{4})", "text": "x 6104 y", "match": true, "groups": { "origin_last4": "6104" } },
    { "name": "bounded quantifier", "pattern": "^a{2}$", "text": "aa", "match": true },
    { "name": "bounded quantifier too few", "pattern": "^a{2}$", "text": "a", "match": false },
    { "name": "bounded range", "pattern": "^a{1,3}$", "text": "aaa", "match": true },
    { "name": "bounded open range", "pattern": "^a{2,}$", "text": "aaaa", "match": true },
    { "name": "literal brace", "pattern": "a{b", "text": "a{b", "match": true },
    { "name": "stray closing brace", "pattern": "a}b", "text": "a}b", "match": true },
    { "name": "boundary next to persian letters", "pattern": "\\bpassword\\b", "flags": "i", "text": "رمزpassword", "match": true },
    { "name": "boundary inside a word", "pattern": "\\bpassword\\b", "flags": "i", "text": "xpassword", "match": false },
    { "name": "not boundary", "pattern": "\\Bass", "text": "password", "match": true },
    { "name": "digit class is ascii only", "pattern": "\\d", "text": "۵", "match": false },
    { "name": "digit class in a set", "pattern": "[\\d,]+", "text": "1,234", "match": true },
    { "name": "whitespace class matches nbsp", "pattern": "a\\sb", "text": "a b", "match": true },
    { "name": "whitespace class matches em space", "pattern": "a\\sb", "text": "a b", "match": true },
    { "name": "whitespace class excludes NEL", "pattern": "a\\sb", "text": "a\u0085b", "match": false },
    { "name": "non-whitespace class includes NEL", "pattern": "a\\Sb", "text": "a\u0085b", "match": true },
    { "name": "word class", "pattern": "^\\w+$", "text": "abc_123", "match": true },
    { "name": "word class excludes persian letters", "pattern": "^\\w+$", "text": "abcالف", "match": false },
    { "name": "dollar is the very end", "pattern": "5$", "text": "x5", "match": true },
    { "name": "dollar not before more text", "pattern": "5$", "text": "5 y", "match": false },
    { "name": "dot excludes newline", "pattern": "a.b", "text": "a\nb", "match": false },
    { "name": "dot matches NEL", "pattern": "a.b", "text": "a\u0085b", "match": true },
    { "name": "case-insensitive ascii", "pattern": "otp", "flags": "i", "text": "Your OTP", "match": true },
    { "name": "case-sensitive by default", "pattern": "otp", "text": "Your OTP", "match": false },
    { "name": "lazy quantifier", "pattern": "a+?", "text": "aaa", "match": true },
    { "name": "square bracket inside a set", "pattern": "[[]", "text": "[", "match": true },
    { "name": "ampersand inside a set", "pattern": "[a&&b]", "text": "&", "match": true },
    { "name": "escaped closing bracket in a set", "pattern": "[a\\]]", "text": "]", "match": true },
    { "name": "negated shorthand inside a set", "pattern": "^[a\\D]+$", "text": "abc", "match": true },
    { "name": "alternation and non-capturing group", "pattern": "(?:رمز|کد)\\s*پویا", "text": "رمز   پویا", "match": true },
    { "name": "lookahead is shared by both engines", "pattern": "a(?=b)", "text": "ab", "match": true },
    { "name": "contract OTP pattern: dynamic password", "pattern": "رمز\\s*(پویا|یکبار|دوم|عبور)", "text": "رمز پویا: 482913", "match": true },
    { "name": "contract OTP pattern: english words", "pattern": "\\b(otp|password|passcode)\\b", "flags": "i", "text": "Your Password is 1", "match": true },
    { "name": "contract OTP pattern: confirmation code", "pattern": "کد\\s*(تایید|تأیید|ورود|فعال\\s*سازی|امنیتی)", "text": "کد فعال سازی شما", "match": true },

    { "name": "lookbehind", "pattern": "(?<=a)b", "rejected": true },
    { "name": "negative lookbehind", "pattern": "(?<!a)b", "rejected": true },
    { "name": "atomic group", "pattern": "(?>a)", "rejected": true },
    { "name": "possessive plus", "pattern": "a++", "rejected": true },
    { "name": "possessive star", "pattern": "a*+", "rejected": true },
    { "name": "possessive bounded", "pattern": "a{2}+", "rejected": true },
    { "name": "inline flags", "pattern": "(?i)a", "rejected": true },
    { "name": "inline flags group", "pattern": "(?i:a)", "rejected": true },
    { "name": "named backreference", "pattern": "(?<x>a)\\k<x>", "rejected": true },
    { "name": "unicode property", "pattern": "\\p{L}", "rejected": true },
    { "name": "quote escape", "pattern": "\\Qa\\E", "rejected": true },
    { "name": "empty set", "pattern": "[]", "rejected": true },
    { "name": "open set", "pattern": "[abc", "rejected": true },
    { "name": "trailing backslash", "pattern": "abc\\", "rejected": true },
    { "name": "unknown flag", "pattern": "a", "flags": "g", "rejected": true }
  ]
}
